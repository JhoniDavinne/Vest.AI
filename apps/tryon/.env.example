# Copie para apps/tryon/.env (nunca commitar .env). Prefixo obrigatorio: TRYON_
# Nenhum secret e necessario: os checkpoints sao publicos no HuggingFace (zhengchong/CatVTON, CC BY-NC-SA 4.0).

TRYON_HOST=127.0.0.1
TRYON_PORT=8100

# Somente "cuda" e aceito. Sem CUDA o servico NAO inicia (sem fallback silencioso para CPU).
TRYON_DEVICE=cuda
# bf16 (padrao, Ampere+/Blackwell) | fp16 | no (fp32)
TRYON_PRECISION=bf16

# Checkpoints (mecanismo oficial huggingface_hub). Cache FORA do OneDrive/repositorio.
TRYON_BASE_MODEL=booksforcharlie/stable-diffusion-inpainting
TRYON_ATTN_REPO=zhengchong/CatVTON
TRYON_ATTN_VERSION=mix
TRYON_MODEL_PATH=C:\Users\<usuario>\AppData\Local\veste-ai\tryon\models

# Resultados (PNG, expiram) e temporarios do DensePose
TRYON_OUTPUT_PATH=C:\Users\<usuario>\AppData\Local\veste-ai\tryon\results
TRYON_TEMP_PATH=C:\Users\<usuario>\AppData\Local\veste-ai\tryon\tmp
TRYON_RESULT_TTL_SECONDS=900

# Inferencia (defaults do app.py oficial)
TRYON_WIDTH=768
TRYON_HEIGHT=1024
TRYON_NUM_INFERENCE_STEPS=50
TRYON_GUIDANCE_SCALE=2.5
TRYON_SEED=42

# Operacao
TRYON_MAX_CONCURRENT_JOBS=1
TRYON_QUEUE_WAIT_SECONDS=0
TRYON_MAX_UPLOAD_MB=8
TRYON_MIN_IMAGE_SIDE=256
TRYON_MAX_IMAGE_SIDE=4096
TRYON_SKIP_SAFETY_CHECK=false
