# Copie para apps/api/.env ou exporte no shell.
# Prefixo obrigatório das variáveis da API: VESTE_

VESTE_ENVIRONMENT=development
VESTE_DATABASE_URL=postgresql+psycopg://veste:veste@localhost:5432/veste_ai
VESTE_AUTO_CREATE_SCHEMA=true
VESTE_AUTO_SEED=true
VESTE_DEMO_API_KEY=veste_demo_key_loja_parceira

# Front-end (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_API_KEY=veste_demo_key_loja_parceira

# Usado pelo Next no servidor (Docker: http://api:8000)
API_URL=http://localhost:8000
