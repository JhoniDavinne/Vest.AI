# VESTE.AI — variaveis de ambiente (exemplo). Copie para .env / apps/api/.env conforme o uso.
# NUNCA commitar .env real, secrets, checkpoints, modelos, fotos, resultados ou cache HuggingFace.
# Com Docker: as variaveis interpoladas em docker/docker-compose.yml podem vir deste arquivo
# (docker compose --env-file .env ...) ou do ambiente.

# ==================================================================== WEB (apps/web, Next.js)
# URL da API vista pelo NAVEGADOR (inlined no bundle em build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_API_KEY=veste_demo_key_loja_parceira
# URL da API vista pelo servidor Next (RSC). Docker: http://api:8000
API_URL=http://localhost:8000
WEB_PORT=3000

# ==================================================================== API (apps/api, FastAPI) — prefixo VESTE_
VESTE_ENVIRONMENT=development            # development | production (producao: CORS restrito, sem fallback SQLite)
API_PORT=8000
VESTE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
VESTE_CORS_ALLOW_ANY_ORIGIN_IN_DEV=true  # fora de producao aceita qualquer origem (widget em terceiros)
VESTE_TRUSTED_HOSTS=["*"]                # producao: ["api.exemplo.com","localhost"]
VESTE_LOG_JSON=false                     # true em containers (uma linha JSON por evento)
VESTE_LOG_LEVEL=INFO
VESTE_UVICORN_WORKERS=1                  # Docker: processos uvicorn (try-on sincrono ocupa 1 thread ~37 s)
VESTE_UVICORN_TIMEOUT_KEEP_ALIVE=75
VESTE_FORWARDED_ALLOW_IPS=*              # reverse proxy futuro: IPs confiaveis para X-Forwarded-*
VESTE_DEMO_API_KEY=veste_demo_key_loja_parceira
VESTE_MAX_PHOTO_BYTES=8388608

# ==================================================================== DATABASE (PostgreSQL 16)
POSTGRES_USER=veste
POSTGRES_PASSWORD=veste                  # troque em qualquer ambiente compartilhado
POSTGRES_DB=veste_ai
POSTGRES_PORT=5432
VESTE_DATABASE_URL=postgresql+psycopg://veste:veste@localhost:5432/veste_ai
# Local sem Docker: fallback SQLite automatico fora de producao (VESTE_SQLITE_FALLBACK_URL).
# Docker/compose: VESTE_ALLOW_SQLITE_FALLBACK=false (nao mascara falha do Postgres).
VESTE_ALLOW_SQLITE_FALLBACK=true
VESTE_AUTO_CREATE_SCHEMA=true            # dev local (create_all + compat). Docker: false (Alembic no prestart)
VESTE_RUN_MIGRATIONS=true                # Docker: `alembic upgrade head` no prestart (nao destrutivo)
VESTE_DB_WAIT_SECONDS=60
VESTE_AUTO_SEED=true                     # popula catalogo demo se o banco estiver vazio

# ==================================================================== TRYON (provador com foto, experimental)
# --- lado da API (adaptador) ---
VESTE_TRYON_ENABLED=false                # false: aplicacao funciona normalmente sem o recurso
VESTE_TRYON_PROVIDER=catvton
VESTE_TRYON_URL=http://127.0.0.1:8100    # Docker (profile gpu): http://tryon:8100
VESTE_TRYON_TIMEOUT_S=120                # inferencia ~37 s na RTX 5070
VESTE_TRYON_RESULT_TTL_S=900
VESTE_TRYON_FLAT_IMAGE_ALLOWED_HOSTS=[]  # hosts http(s) permitidos para Product.flat_image_url (JSON)
# --- lado do servico apps/tryon (prefixo TRYON_; ver apps/tryon/.env.example) ---
TRYON_PORT=8100
TRYON_PRECISION=bf16
TRYON_QUEUE_WAIT_SECONDS=0               # 0 = segunda requisicao simultanea recebe 429 busy
# Docker: profile gpu -> COMPOSE_PROFILES=gpu (ver docker/gpu.env). Requer NVIDIA Container Toolkit.
