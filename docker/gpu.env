# Ativa o servico `tryon` (CatVTON, GPU NVIDIA) e liga o provador com foto na API.
# Uso:  docker compose -f docker/docker-compose.yml --env-file docker/gpu.env up --build
# Requer NVIDIA Container Toolkit (Linux) ou Docker Desktop com WSL2 + driver NVIDIA (Windows).
# Nenhum secret: apenas flags de composicao.
COMPOSE_PROFILES=gpu
VESTE_TRYON_ENABLED=true
VESTE_TRYON_TIMEOUT_S=120
VESTE_TRYON_RESULT_TTL_S=900
TRYON_PRECISION=bf16
